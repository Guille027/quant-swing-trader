# Copy to .env. NEVER commit real secrets.
# QSTS_ENV selects the environment: development | paper | live
QSTS_ENV=development

# Database (SQLite by default; any SQLAlchemy URL works)
QSTS_DATABASE_URL=sqlite:///var/qsts.db

# Runtime state directory (kill switch flag, logs)
QSTS_STATE_DIR=var

# Live trading is DISABLED unless this is explicitly true AND QSTS_ENV=live
QSTS_LIVE_TRADING_ENABLED=false

# Broker keys are environment-scoped. Only the key matching QSTS_ENV is ever loaded.
QSTS_PAPER_BROKER_API_KEY=
QSTS_LIVE_BROKER_API_KEY=

# AI provider (phase 9)
QSTS_GEMINI_API_KEY=
QSTS_GEMINI_MODEL=gemini-2.5-flash
QSTS_AI_MAX_CALLS_PER_DAY=50

# Research: data from this date onwards is the out-of-sample vault (opened once per strategy)
QSTS_OOS_START=2023-01-01
QSTS_BENCHMARK=SPY

# Telegram messages of the simulation (set them up from the app: 3 · Simulación -> Avisos por Telegram)
QSTS_TELEGRAM_BOT_TOKEN=
QSTS_TELEGRAM_CHAT_ID=
QSTS_DAILY_REPORT_DELAY_MIN=45
