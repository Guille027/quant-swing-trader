# Copy to .env. NEVER commit real secrets. The app writes the keys below itself when you enter them in Ajustes.
QSTS_ENV=development

# Database (SQLite by default; any SQLAlchemy URL works)
QSTS_DATABASE_URL=sqlite:///var/qsts.db

# Runtime state directory (logs, launcher state, data copies)
QSTS_STATE_DIR=var

# Live trading is DISABLED. This app only connects to Alpaca's PAPER (simulated money) account.
QSTS_LIVE_TRADING_ENABLED=false

# Alpaca PAPER account keys (Ajustes -> Alpaca)
QSTS_ALPACA_API_KEY=
QSTS_ALPACA_SECRET_KEY=

# Market benchmark (buy & hold reference)
QSTS_BENCHMARK=SPY

# Telegram messages of the paper trader (Ajustes -> Avisos por Telegram)
QSTS_TELEGRAM_BOT_TOKEN=
QSTS_TELEGRAM_CHAT_ID=
# minutes after the NYSE close before the day's signals (Yahoo publishes the day's bar)
QSTS_DAILY_REPORT_DELAY_MIN=45
